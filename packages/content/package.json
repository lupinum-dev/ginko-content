{
  "name": "@lupinum/ginko-content",
  "version": "0.1.7",
  "description": "Collection-first content engine for Nuxt",
  "homepage": "https://ginko-content.nuxt.dev",
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko-content/issues"
  },
  "keywords": [
    "nuxt",
    "content",
    "module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko-content.git",
    "directory": "packages/content"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "bin": {
    "ginko-content": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./server": {
      "types": "./dist/public/server.d.ts",
      "import": "./dist/public/server.js",
      "default": "./dist/public/server.js"
    },
    "./provider": {
      "types": "./dist/public/provider.d.ts",
      "import": "./dist/public/provider.js",
      "default": "./dist/public/provider.js"
    },
    "./client": {
      "types": "./dist/public/client.d.ts",
      "import": "./dist/public/client.js",
      "default": "./dist/public/client.js"
    },
    "./agent": {
      "types": "./dist/public/agent.d.ts",
      "import": "./dist/public/agent.js",
      "default": "./dist/public/agent.js"
    },
    "./cms-contract": {
      "types": "./dist/cms-contract/index.d.ts",
      "import": "./dist/cms-contract/index.js",
      "default": "./dist/cms-contract/index.js"
    },
    "./cms-import": {
      "types": "./dist/cms-import/index.d.ts",
      "import": "./dist/cms-import/index.js",
      "default": "./dist/cms-import/index.js"
    },
    "./testing/provider-fixture": {
      "types": "./dist/testing/provider-fixture.d.ts",
      "import": "./dist/testing/provider-fixture.js",
      "default": "./dist/testing/provider-fixture.js"
    },
    "./testing/provider-contract": {
      "types": "./dist/testing/provider-contract.d.ts",
      "import": "./dist/testing/provider-contract.js",
      "default": "./dist/testing/provider-contract.js"
    },
    "./transformers": {
      "types": "./dist/runtime/transformers/define.d.ts",
      "import": "./dist/runtime/transformers/define.js",
      "default": "./dist/runtime/transformers/define.js"
    },
    "./transformers/markdown": {
      "types": "./dist/runtime/transformers/markdown.d.ts",
      "import": "./dist/runtime/transformers/markdown.js",
      "default": "./dist/runtime/transformers/markdown.js"
    },
    "./transformers/yaml": {
      "types": "./dist/runtime/transformers/yaml.d.ts",
      "import": "./dist/runtime/transformers/yaml.js",
      "default": "./dist/runtime/transformers/yaml.js"
    },
    "./transformers/json": {
      "types": "./dist/runtime/transformers/json.d.ts",
      "import": "./dist/runtime/transformers/json.js",
      "default": "./dist/runtime/transformers/json.js"
    },
    "./transformers/csv": {
      "types": "./dist/runtime/transformers/csv/index.d.ts",
      "import": "./dist/runtime/transformers/csv/index.js",
      "default": "./dist/runtime/transformers/csv/index.js"
    }
  },
  "web-types": "./dist/web-types.json",
  "files": [
    "compatibility.json",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nuxt-module-build build && pnpm build:web-types",
    "build:web-types": "vue-docgen-web-types src/runtime/app/components/ ./dist/web-types.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/preflight-release.mjs"
  },
  "dependencies": {
    "@comark/vue": "^0.4.0",
    "@nuxt/kit": "^4.4.7",
    "@shikijs/transformers": "^4.2.0",
    "comark": "^0.4.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "globby": "^16.2.0",
    "h3": "1.15.11",
    "jiti": "^2.7.0",
    "js-yaml": "^4.2.0",
    "json5": "^2.2.3",
    "knitwork": "^1.3.0",
    "minisearch": "^7.2.0",
    "nitropack": "^2.13.4",
    "ohash": "^2.0.11",
    "pagefind": "^1.5.2",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "scule": "^1.3.0",
    "shiki": "^4.2.0",
    "slugify": "^1.6.9",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.2",
    "nuxt": "4.4.7",
    "unbuild": "^3.6.1",
    "vue-docgen-web-types": "^0.1.8"
  },
  "peerDependencies": {
    "nuxt": ">=4.4.7",
    "vitest": ">=4.1.6",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
