{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@lupinum/ginko-content": [
        "../../../packages/content/dist/module"
      ],
      "@lupinum/ginko-content/config": [
        "../../../packages/content/dist/config"
      ],
      "#build": [
        "./.nuxt"
      ],
      "#build/*": [
        "./.nuxt/*"
      ],
      "#app": [
        "../../../node_modules/nuxt/dist/app"
      ],
      "#app/*": [
        "../../../node_modules/nuxt/dist/app/*"
      ],
      "#components": [
        "./.nuxt/components"
      ],
      "#content/virtual/transformers": [
        "./.nuxt/content/virtual-transformers"
      ],
      "#content/virtual/config": [
        "./.nuxt/content/virtual-config"
      ],
      "#imports": [
        "./.nuxt/imports"
      ]
    }
  },
  "include": [
    "./app.vue",
    "./content.config.ts",
    "./types/**/*.ts"
  ]
}
